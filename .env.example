# Waarden met spaties moeten tussen aanhalingstekens: init-passwd.sh leest dit
# bestand met 'source', en zonder quotes probeert de shell het tweede woord als
# commando uit te voeren.
MESHSTATS_PORT=8080
MCS_SITE_NAME="MeshCore Repeater Stats"
MCS_RETENTION_DAYS=180
MCS_HEARTBEAT_MIN=5
# Ruwe pakketten komen veel sneller binnen dan metingen: eigen bewaartermijn
MCS_PACKET_RETENTION_DAYS=7

# Grootste request-body die de site aanvaardt, op elke route en methode.
MCS_MAX_BODY_BYTES=2000000
# Aantal proxies vóór de app. De inlogbegrenzing telt zoveel X-Forwarded-For-
# entries vanaf rechts om het echte adres te vinden; 1 = cloudflared rechtstreeks
# naar de app. Alleen verhogen als je er echt een hop bij zet.
MCS_TRUSTED_PROXY_HOPS=1

# Tijdreeksdatabank voor de metingen. Leeg laten houdt alles in SQLite; dat werkt,
# maar dan worden ruwe punten uitgedund volgens MCS_HEARTBEAT_MIN. De rest
# (repeaters, actuele waarden, contacten, buren, pakketten) blijft hoe dan ook in
# SQLite. De container publiceert geen poort naar buiten: enkel de site praat ermee.
MCS_TSDB_URL=http://victoria:8428
MCS_TSDB_RETENTION=180d

# MQTT: nodes publiceren hier hun statistieken naartoe
MQTT_PORT=1883
MCS_MQTT_HOST=mosquitto
MCS_MQTT_PORT=1883
MCS_MQTT_USER=meshstats
MCS_MQTT_PASS=verander-dit-wachtwoord
MCS_MQTT_TOPIC=meshcore/+/stats
# Elk ontvangen LoRa-pakket, ruw; voedt de live kaart op de startpagina
MCS_MQTT_RX_TOPIC=meshcore/+/rx
# Het enige topic waarop de site zelf publiceert: één woord dat een node vraagt
# nu zijn instellingen te lezen of een statusbericht te sturen. {node} wordt
# ingevuld met de pubkey-prefix van die node. Vereist MeshStats-firmware 1.8.0
# op de node en een ACL die haar op dit topic laat lezen (mosquitto/acl.example).
MCS_MQTT_CMD_TOPIC=meshcore/{node}/cmd

# Kloksynchronisatie: de site stuurt periodiek 'time <epoch>' over datzelfde
# cmd-topic naar elke node die rechtstreeks publiceert. Die zet zijn eigen klok
# en controleert daarna over LoRa de klokken van de repeaters die hij monitort.
# Vereist MeshStats-firmware 1.10.0 op de node.
#
# Waarom dit nodig is: een MeshCore-node zet zijn klok nooit uit zichzelf goed.
# Na een herstart -- lege accu, watchdog, stroomstoring -- staat hij op de datum
# die in de firmware zit, en alles wat hij daarna zegt draagt die tijd mee.
MCS_CLOCKSYNC_ENABLED=1
# Uren tussen twee rondes. Klokdrift op een ESP32 is enkele seconden per dag en
# de firmware corrigeert een gemonitorde node pas vanaf twee minuten afwijking,
# dus dagelijks is ruim voldoende; wat dit getal werkelijk bepaalt is hoe lang
# een node die net herstart is met een klok uit 2024 mag rondlopen. Zendtijd is
# het schaarse goed: de node doet zijn LoRa-helft hoe dan ook hoogstens één keer
# per uur, wat er ook binnenkomt.
MCS_CLOCKSYNC_HOURS=24
# Hoeveel onzekerheid de kernel over zijn eigen klok mag hebben voor de site hem
# nog gelooft, in seconden. De kernel laat die marge tussen twee NTP-correcties
# groeien met 500 ppm en geeft het bij 16 s helemaal op; 10 s betekent dus ruwweg
# "de host is in de laatste vijfeneenhalf uur nog bijgestuurd". Let op waar dat
# oordeel vandaan komt: in een LXC deelt de container de klok van de Proxmox-host
# en leest deze controle dus de discipline van die HOST. Staat de NTP daar fout,
# dan loopt dit alles keurig en volledig verkeerd mee.
MCS_CLOCKSYNC_MAX_ERROR_S=10
# Hoeveel de wandklok tussen twee rondes mag verspringen ten opzichte van de
# monotone klok voor de site het een sprong noemt in plaats van een correctie.
MCS_CLOCKSYNC_MAX_JUMP_S=30
