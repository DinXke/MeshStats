# Waarden met spaties moeten tussen aanhalingstekens: init-passwd.sh leest dit
# bestand met 'source', en zonder quotes probeert de shell het tweede woord als
# commando uit te voeren.
MESHSTATS_PORT=8080
MCS_SITE_NAME="MeshCore Repeater Stats"
MCS_RETENTION_DAYS=180
MCS_HEARTBEAT_MIN=5
# Ruwe pakketten komen veel sneller binnen dan metingen: eigen bewaartermijn
MCS_PACKET_RETENTION_DAYS=7

# Grootste request-body die de site aanvaardt, op elke route en methode.
MCS_MAX_BODY_BYTES=2000000
# Aantal proxies vóór de app. De inlogbegrenzing telt zoveel X-Forwarded-For-
# entries vanaf rechts om het echte adres te vinden; 1 = cloudflared rechtstreeks
# naar de app. Alleen verhogen als je er echt een hop bij zet.
MCS_TRUSTED_PROXY_HOPS=1

# MQTT: nodes publiceren hier hun statistieken naartoe
MQTT_PORT=1883
MCS_MQTT_HOST=mosquitto
MCS_MQTT_PORT=1883
MCS_MQTT_USER=meshstats
MCS_MQTT_PASS=verander-dit-wachtwoord
MCS_MQTT_TOPIC=meshcore/+/stats
# Elk ontvangen LoRa-pakket, ruw; voedt de live kaart op de startpagina
MCS_MQTT_RX_TOPIC=meshcore/+/rx
