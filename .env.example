# Configuratie van MeshManager.
#
# Waarden met spaties moeten tussen aanhalingstekens: init-passwd.sh leest dit
# bestand met 'source', en zonder quotes probeert de shell het tweede woord als
# commando uit te voeren.
#
# KOM JE VAN MESHSTATS? Dan hoef je niets te doen. Elke variabele heette vroeger
# MCS_ in plaats van MM_, en de server leest allebei -- de nieuwe naam wint als
# je ze samen zet. Je bestaande .env blijft dus gewoon werken; deze lijst is wat
# je zou schrijven als je vandaag opnieuw begon. Zie docs/migration.md voor de
# volgorde waarin je bijwerkt, en server/app/config.py voor wanneer de oude
# namen mogen verdwijnen.
MESHMANAGER_PORT=8080
MM_SITE_NAME="MeshManager"
MM_RETENTION_DAYS=180
MM_HEARTBEAT_MIN=5
# Ruwe pakketten komen veel sneller binnen dan metingen: eigen bewaartermijn.
# Let op: dit is enkel de STANDAARD voor een verse installatie. Zodra je de
# waarde op de beheerpagina wijzigt, wint die -- daar staat ze in de tabel
# `settings` en werkt ze meteen, zonder de container te herstarten. Dit getal
# bepaalt meteen ook het venster van de heatmap op de live kaart.
MM_PACKET_RETENTION_DAYS=7

# De twee bovengrenzen die het veilig maken om die termijn te verhogen. Een
# termijn in dagen is namelijk geen bescherming: bij een verkeersexplosie loopt
# de schijf alsnog vol terwijl de instelling keurig gerespecteerd wordt. Daarom
# is de termijn hierboven wat we WILLEN, en zijn deze twee wat we BELOVEN. Wordt
# een van beide geraakt, dan gaan de oudste pakketten weg tot het weer past --
# wie het eerst binnenkwam gaat het eerst weg (FIFO) -- en zegt de beheerpagina
# met zoveel woorden dat de termijn niet gehaald is.
#
# Rijen eerst, want een rij is wat een pakket kost en tellen is goedkoop. Gemeten
# op een draaiende server: 7 477 pakketten nemen ongeveer 2,5 MB in beslag,
# indexen meegerekend, bij een instroom van zo'n 3 738 pakketten per dag.
# 200 000 rijen is dus ruwweg 53 dagen verkeer in een kleine 80 MB.
MM_PACKET_MAX_ROWS=200000
# Megabytes als tweede, want megabytes zijn wat er werkelijk opraakt. Dit telt
# het hele bestand (plus de WAL), niet alleen de pakketten, en is dus de grens
# die niet weg te redeneren valt door het rijmaximum te verhogen.
MM_DB_MAX_MB=512
# Minuten tussen twee opruimrondes. Er wordt ook bij het opstarten gesnoeid,
# maar een server die maanden aan één stuk draait moet tussendoor opruimen --
# anders is de bewaartermijn geen regel maar een opstartritueel.
MM_PRUNE_MINUTES=60

# Grootste request-body die de site aanvaardt, op elke route en methode.
MM_MAX_BODY_BYTES=2000000
# Aantal proxies vóór de app. De inlogbegrenzing telt zoveel X-Forwarded-For-
# entries vanaf rechts om het echte adres te vinden; 1 = cloudflared rechtstreeks
# naar de app. Alleen verhogen als je er echt een hop bij zet.
MM_TRUSTED_PROXY_HOPS=1

# Tijdreeksdatabank voor de metingen. Leeg laten houdt alles in SQLite; dat werkt,
# maar dan worden ruwe punten uitgedund volgens MM_HEARTBEAT_MIN. De rest
# (repeaters, actuele waarden, contacten, buren, pakketten) blijft hoe dan ook in
# SQLite. De container publiceert geen poort naar buiten: enkel de site praat ermee.
MM_TSDB_URL=http://victoria:8428
MM_TSDB_RETENTION=180d

# MQTT: nodes publiceren hier hun statistieken naartoe
MQTT_PORT=1883
MM_MQTT_HOST=mosquitto
MM_MQTT_PORT=1883
MM_MQTT_USER=meshmanager
MM_MQTT_PASS=verander-dit-wachtwoord
# Het topicvoorvoegsel van dit project. De site luistert ALTIJD ook naar het
# oude 'meshcore', zolang die terugval bestaat, dus tijdens de overgang naar
# MeshManager hoef je hier niets voor te doen: een node die nog niet geflasht
# is komt gewoon binnen. /admin toont per voorvoegsel hoeveel nodes er zijn.
MM_MQTT_PREFIX=meshmanager

# Minuten stilte waarna /admin meldt dat de invoer wel verbonden is maar niets
# binnenkrijgt. Ruim, want een node op zonnestroom publiceert 's nachts hooguit
# een keer per uur; een waarschuwing die elke nacht afgaat leert iedereen te
# negeren. Zet hem lager als je nodes vaak publiceren en je het sneller wilt zien.
MM_MQTT_QUIET_MIN=90

# MM_MQTT_TOPIC en MM_MQTT_RX_TOPIC bestaan nog, maar zijn niet meer nodig en
# staan daarom niet meer ingevuld. Ze zetten een EXTRA inschrijving bovenop
# de voorvoegsels hierboven, en dat is alleen zinvol als je op een gedeelde
# broker onder een eigen tak draait:
#   MM_MQTT_TOPIC=eigen/tak/+/stats
#   MM_MQTT_RX_TOPIC=eigen/tak/+/rx
# Het enige topic waarop de site zelf publiceert: één woord dat een node vraagt
# nu zijn instellingen te lezen of een statusbericht te sturen. {node} wordt
# ingevuld met de pubkey-prefix van die node. Vereist nodefirmware 1.8.0
# op de node en een ACL die haar op dit topic laat lezen (mosquitto/acl.example).
# {prefix} wordt ingevuld met het voorvoegsel waarop DIE ENE node zich meldt,
# want tijdens de overgang luistert niet elke node op hetzelfde. Zet je hier
# een patroon zonder {prefix}, dan wordt dat letterlijk gebruikt.
MM_MQTT_CMD_TOPIC={prefix}/{node}/cmd

# Kloksynchronisatie: de site stuurt periodiek 'time <epoch>' over datzelfde
# cmd-topic naar elke node die rechtstreeks publiceert. Die zet zijn eigen klok
# en controleert daarna over LoRa de klokken van de repeaters die hij monitort.
# Vereist nodefirmware 1.10.0 op de node.
#
# Waarom dit nodig is: een MeshCore-node zet zijn klok nooit uit zichzelf goed.
# Na een herstart -- lege accu, watchdog, stroomstoring -- staat hij op de datum
# die in de firmware zit, en alles wat hij daarna zegt draagt die tijd mee.
MM_CLOCKSYNC_ENABLED=1
# Uren tussen twee rondes. Klokdrift op een ESP32 is enkele seconden per dag en
# de firmware corrigeert een gemonitorde node pas vanaf twee minuten afwijking,
# dus dagelijks is ruim voldoende; wat dit getal werkelijk bepaalt is hoe lang
# een node die net herstart is met een klok uit 2024 mag rondlopen. Zendtijd is
# het schaarse goed: de node doet zijn LoRa-helft hoe dan ook hoogstens één keer
# per uur, wat er ook binnenkomt.
MM_CLOCKSYNC_HOURS=24
# Hoeveel onzekerheid de kernel over zijn eigen klok mag hebben voor de site hem
# nog gelooft, in seconden. De kernel laat die marge tussen twee NTP-correcties
# groeien met 500 ppm en geeft het bij 16 s helemaal op; 10 s betekent dus ruwweg
# "de host is in de laatste vijfeneenhalf uur nog bijgestuurd". Let op waar dat
# oordeel vandaan komt: in een LXC deelt de container de klok van de Proxmox-host
# en leest deze controle dus de discipline van die HOST. Staat de NTP daar fout,
# dan loopt dit alles keurig en volledig verkeerd mee.
MM_CLOCKSYNC_MAX_ERROR_S=10
# Hoeveel de wandklok tussen twee rondes mag verspringen ten opzichte van de
# monotone klok voor de site het een sprong noemt in plaats van een correctie.
MM_CLOCKSYNC_MAX_JUMP_S=30

# --- Firmware-upgrades --------------------------------------------------------
# De beheerpagina /admin/firmware haalt de beschikbare images bij GitHub
# Releases van deze repository en schrijft ze over HTTP naar een node. Zie
# docs/firmware-upgrade.md voor de hele weg en waarom hij zo loopt.
#
# Welke repository. Normaal niet nodig: de server leidt owner/repo af uit de
# git-remote van de werkkopie waar hij in staat. In een container zit geen .git,
# en dan is dit het enige wat het nog kan zeggen. Hardcoderen in de broncode is
# geen optie -- deze repo is publiek, en een fork hoort naar zijn eigen releases
# te kijken in plaats van stilletjes images van een vreemde binnen te halen.
#MM_GITHUB_REPO=eigenaar/repo
# De login van de beheerpagina van de nodes zelf (dezelfde als voor /update en
# de telnet-console). Zonder deze twee blijft elke upgradeknop uit -- dat is met
# opzet: een image gaat achter de eigen login van de node langs en er is geen
# lichtere variant, want wie firmware mag schrijven mag ook de privésleutel
# downloaden.
#
# Bewust in de omgeving en niet in de database: een wachtwoord dat meelift in
# een back-up van de statistieken is een wachtwoord dat je niet meer overziet.
#MM_FW_NODE_USER=admin
#MM_FW_NODE_PASS=
# Minuten dat de releaselijst gecachet blijft. GitHub laat anoniem 60 verzoeken
# per uur per IP toe, gedeeld met alles wat er verder op die machine draait, en
# een beheerpagina die bij elke verversing opnieuw vraagt maakt dat in een
# middag op. Bij een fout blijft de laatste goede lijst staan.
#MM_FW_CACHE_MIN=15
# Let op wat deze twee wél en niet zijn. Ze zijn de weblogin van de beheerpagina
# van je EIGEN nodes -- dezelfde als voor /update en de telnetconsole -- en ze
# openen /api/fw, /api/cfg en /api/mon op nodes die de server over IP bereikt.
#
# Ze zijn NIET de inloggegevens voor nodes van iemand anders. Zo'n node bereik je
# over LoRa vanaf een monitor, en de rechten daarvoor horen bij die monitor:
# ofwel staat zijn publieke sleutel in de toegangslijst van de overkant
# (`setperm <pubkey> 3`, en dan is er nergens een wachtwoord), ofwel houdt de
# monitor het adminwachtwoord in zijn eigen monitorlijst. De site kan dat
# wachtwoord zetten en geeft het door zonder het te bewaren.
#
# Laat ze leeg als je niet aan het upgraden bent: dan zijn die wegen dicht en
# werkt de rest gewoon. Zie docs/nl/security.md voor wat een inbraak op de site
# oplevert met en zonder deze twee.

# --- Uitvraagschema -----------------------------------------------------------
# Hoe vaak de CLI-instellingen van een node opnieuw uitgevraagd worden staat PER
# NODE op de beheerpagina, en standaard uit. Deze drie variabelen zijn de
# bovengrenzen daaromheen: het interval per node is een wens, dit is wat er
# werkelijk gebeurt.
#
# Waarom die grenzen er zijn: één ronde is twintig vragen en twintig antwoorden
# over LoRa, nominaal 286 s. Bij een gemonitorde node betaalt een repeater op een
# dak dat, uit een zonnepaneel, op een band die van iedereen is. Tien nodes op
# hetzelfde uur zou de band een uur bezet houden.
#MM_SWEEP_ENABLED=1
# Minimumafstand tussen twee rondes, welke node het ook betreft. Nooit lager dan
# 10, want dat is MON_SET_MIN_GAP_MS in de firmware: korter vragen heeft geen zin
# omdat de monitor het toch weigert, en zou de site iets laten beloven wat niet
# gebeurt.
#MM_SWEEP_MIN_GAP_MIN=15
# Bovengrens per etmaal over alle nodes samen. Vangt het geval dat het interval
# per node niet vangt: twintig nodes op dagelijks zetten zonder de optelsom te
# maken. Bij een afstand van 15 minuten passen er 96 in een dag; 48 laat de helft
# van de band vrij voor alles wat er verder gebeurt.
#MM_SWEEP_MAX_PER_DAY=48

# --- Webpush (/meshmoni) -------------------------------------------------------
# Pushmeldingen op de telefoon zodra er een alert binnenkomt, via de
# monitoringsubsite /meshmoni. Leeg = uit, met die reden zichtbaar in de UI --
# dezelfde afspraak als MM_FW_NODE_USER hierboven. De sleutels identificeren
# deze server bij de pushdiensten van de browserleveranciers (VAPID) en zijn
# GEHEIM: de private hoort nergens anders dan hier. Aanmaken (eenmalig, op om
# het even welke machine met de server-afhankelijkheden):
#
#   python -c "from py_vapid import Vapid02; from cryptography.hazmat.primitives import serialization; import base64; v = Vapid02(); v.generate_keys(); print('MM_VAPID_PRIVATE=' + base64.urlsafe_b64encode(v.private_key.private_numbers().private_value.to_bytes(32, 'big')).rstrip(b'=').decode()); print('MM_VAPID_PUBLIC=' + base64.urlsafe_b64encode(v.public_key.public_bytes(serialization.Encoding.X962, serialization.PublicFormat.UncompressedPoint)).rstrip(b'=').decode())"
#
# (py_vapid komt mee met pywebpush; zie ook docs/nl/meshmoni.md.)
#MM_VAPID_PUBLIC=
#MM_VAPID_PRIVATE=
# Contactadres dat in elk ondertekend pushverzoek meereist (mailto:... of een
# https-URL); pushdiensten willen iemand kunnen bereiken als een server zich
# misdraagt. Standaard wijst hij naar de site zelf.
#MM_VAPID_SUBJECT=mailto:beheer@meshmanager.net
# --- Sensornodes met een eigen API over IP -------------------------------------
# Een derde soort node, naast onze repeaterfirmware op de broker en een node die
# door een monitor over LoRa uitgevraagd wordt: een node die zelf een HTTP-API
# aanbiedt. Een MeshUptime-sensornode doet dat -- /status.json, /cfg.json,
# /acl.json en POST /cli -- achter dezelfde weblogin als hierboven
# (MM_FW_NODE_USER / MM_FW_NODE_PASS). Het adres staat PER NODE op de
# beheerpagina, want geen bericht van een node draagt zijn eigen IP.
#
# Zie server/app/sensornode.py en docs/nl/node-management.md.
#
# Uitzetten is een geldige keuze: wie zijn sensornodes niet over IP wil laten
# uitlezen -- omdat de server op een netwerk staat waar dat niet hoort, of omdat
# het mesh de bedoelde weg is -- hoort dat te kunnen zeggen zonder de adressen
# weg te gooien.
#MM_SENSOR_POLL_ENABLED=1
# Seconden tussen twee uitleesrondes. 300 is met opzet hetzelfde tempo als de
# bestaande polling (de Home Assistant-integratie stuurt elke 300 s een volledige
# snapshot) en hetzelfde als MM_HEARTBEAT_MIN: trager geeft gaten in de grafiek,
# sneller levert punten op die niemand tekent. Wie een fijnere resolutie wil, zet
# dit lager EN de hartslag mee -- twee getallen die bij elkaar horen.
#
# Sneller kan technisch: het is één HTTP-verzoek over het lokale net en er is geen
# zendtijd bij betrokken. De rem zit aan de andere kant -- de node bedient
# tussendoor een radio, en elk verzoek gaat door dezelfde lus als het meshwerk.
#
# Dit interval is sinds de alert-afleiding ook de ALERTLATENTIE van de IP-weg:
# een storing wordt pas gezien bij de eerstvolgende ronde, dus tot dit aantal
# seconden na het feit (het mesh zou seconden zijn, maar die schakel is stuk).
# 60 is een verantwoorde ondergrens zolang de node op netvoeding staat: twee
# lichte GET's per ronde over het lokale net, en de eigen pagina van de node
# vraagt al elke 5 s. Op batterij weegt het anders -- daar is de WiFi zelf de
# schaarse post, en polt deze weg een slapende radio wakker.
#MM_SENSOR_POLL_S=300
# Hoe lang de server op zo'n node wacht. Kort, want dit is het lokale net en er
# hangt soms een webverzoek achter te wachten: een node die er is antwoordt in
# tienden van seconden, en een node die weg is, is weg.
#MM_SENSOR_TIMEOUT_S=8

# --- Gebeurtenis-push van sensornodes ------------------------------------------
# De omgekeerde richting van de uitleesronde hierboven: de node meldt zijn
# gebeurtenissen ZELF, op POST /api/sensorpush, seconden na het feit -- waar de
# poll er tot MM_SENSOR_POLL_S naast kan zitten. Het token hieronder is de
# toegang: de node stuurt het als bearer mee, en het hoort dus op precies twee
# plaatsen te bestaan (hier, en in de firmware van de node). Verzin een lange
# willekeurige tekenreeks, bijvoorbeeld:
#
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
#
# Leeg = de weg is dicht: het endpoint antwoordt 503 met die reden, en de
# stiltebewaking (alarm zodra een pushende node drie beloofde hartslagen stil
# blijft) start niet -- dezelfde afspraak als MM_FW_NODE_USER en de
# VAPID-sleutels. GEHEIM, net als die twee: wie dit token heeft kan alarmen
# invoegen en bevestigen.
#
# Dit ENE token opent ook POST /api/companion (de instant-push van
# companion-locatie/-valmeldingen, companions.py): dezelfde vertrouwde
# MeshUptime-node stuurt allebei, en verdient dus geen tweede token.
#MM_PUSH_TOKEN=

# --- Home Assistant (MQTT-discovery) -------------------------------------------
# De weg naar buiten: onze telemetrie verschijnt vanzelf als HA-entiteiten,
# zonder custom component -- net zoals Uptime Kuma dat al doet. Dit is een APARTE
# verbinding naar de broker waar Home Assistant aan hangt (bij ons een EMQX op
# het LAN), niet de eigen ingest-broker onder MM_MQTT_* hierboven: twee brokers,
# twee verbindingen.
#
# Uit tot host EN schakelaar gezet zijn -- dezelfde afspraak als de
# VAPID-sleutels en MM_PUSH_TOKEN. Een host invullen zet nog niets aan; zo kun je
# de broker klaarzetten en pas aanzetten als de EMQX-gebruiker en de ACL er staan.
# Zie docs/nl/ha-integratie.md voor de EMQX-gebruiker en de ACL.
#MM_HA_MQTT_HOST=10.10.10.100
#MM_HA_MQTT_PORT=1883
#MM_HA_MQTT_USER=meshmanager
#MM_HA_MQTT_PASS=verander-dit-wachtwoord
#MM_HA_DISCOVERY_ENABLED=1
# Waar HA naar config-berichten luistert (mqtt: discovery_prefix). 'homeassistant'
# is de standaard van HA zelf; alleen aanpassen als jouw HA iets anders heeft.
#MM_HA_DISCOVERY_PREFIX=homeassistant
# Onder welk voorvoegsel onze state- en availability-topics wonen. Los van het
# ingest-voorvoegsel, met een eigen /ha erin, zodat een broker-ACL "meshmanager
# alleen onder meshmanager/ha/#" kan afdwingen.
#MM_HA_STATE_PREFIX=meshmanager/ha
# Welke nodes we publiceren: 'sensors' (alleen de sensornodes), 'monitored'
# (sensornodes + repeaters die telemetrie melden, standaard) of 'all' (elke
# tracked repeater). Zie server/app/hadiscovery.py.
#MM_HA_SCOPE=monitored
# Na hoeveel minuten stilte een node in HA "niet beschikbaar" wordt. Ruim, om
# dezelfde reden als MM_MQTT_QUIET_MIN.
#MM_HA_STALE_MIN=20
