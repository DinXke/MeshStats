+/* Telemetry is a separate request type because RepeaterStats has no room for
+ * sensors: temperature and voltages come back as CayenneLPP instead. The layout
+ * below mirrors how this same firmware answers the request (handleRequest
+ * above), which is the only specification that exists.
+ *
+ * payload[1] is an INVERSE permission mask -- the far side computes
+ * ~payload[1] -- so zero asks for everything it is willing to give, and it
+ * clamps that to base telemetry itself if we only hold guest rights. */
+bool MyMesh::sendMonitorTelemetryReq(int idx) {
+  if (idx < 0 || idx >= num_monitors) return false;
+  MonitorInfo &m = monitors[idx];
+
+  uint8_t temp[9];
+  uint32_t now = getRTCClock()->getCurrentTimeUnique();
+  memcpy(temp, &now, 4);
+  temp[4] = REQ_TYPE_GET_TELEMETRY_DATA;
+  memset(&temp[5], 0, 4);          // 4 reserved bytes; the first is that mask
+
+  mesh::Packet *pkt = createDatagram(PAYLOAD_TYPE_REQ, m.id, m.shared_secret, temp, sizeof(temp));
+  if (!pkt) return false;
+  sendToMonitor(m, pkt);
+  return true;
+}
