+// Bouwt de JSON-payload voor de statistiekensite, in het formaat dat de
+// ingest-API verwacht: {"repeater":{...},"metrics":{...}}
+size_t MyMesh::fillStatsJson(char *out, size_t max_len) {
+  if (out == NULL || max_len < 256) return 0;
+
+  char pub_hex[13];
+  mesh::Utils::toHex(pub_hex, self_id.pub_key, 6);   // 6 bytes -> 12 hex tekens
+
+  uint32_t uptime_secs = _ms->getMillis() / 1000;
+  uint32_t tx_air = getTotalAirTime() / 1000;
+  uint32_t rx_air = getReceiveAirTime() / 1000;
+
+  int n = snprintf(out, max_len,
+    "{\"repeater\":{\"pubkey_prefix\":\"%s\",\"name\":\"%s\"},"
+    "\"metrics\":{"
+      "\"online\":true,"
+      "\"bat\":%.3f,"
+      "\"uptime\":%.5f,"
+      "\"noise_floor\":%d,"
+      "\"last_rssi\":%d,"
+      "\"last_snr\":%.2f,"
+      "\"airtime\":%.1f,"
+      "\"rx_airtime\":%.1f,"
+      "\"nb_recv\":%u,"
+      "\"nb_sent\":%u,"
+      "\"sent_flood\":%u,"
+      "\"sent_direct\":%u,"
+      "\"recv_flood\":%u,"
+      "\"recv_direct\":%u,"
+      "\"recv_errors\":%u,"
+      "\"tx_queue_len\":%u,"
+      "\"freq\":%.4f,"
+      "\"sf\":%u,"
+      "\"cr\":%u,"
+      "\"tx\":%d"
+    "}}",
+    pub_hex, _prefs.node_name,
+    board.getBattMilliVolts() / 1000.0f,
+    uptime_secs / 86400.0,
+    (int)_radio->getNoiseFloor(),
+    (int)radio_driver.getLastRSSI(),
+    radio_driver.getLastSNR(),
+    tx_air / 60.0f,
+    rx_air / 60.0f,
+    (unsigned)radio_driver.getPacketsRecv(),
+    (unsigned)radio_driver.getPacketsSent(),
+    (unsigned)getNumSentFlood(),
+    (unsigned)getNumSentDirect(),
+    (unsigned)getNumRecvFlood(),
+    (unsigned)getNumRecvDirect(),
+    (unsigned)radio_driver.getPacketsRecvErrors(),
+    (unsigned)_mgr->getOutboundTotal(),
+    _prefs.freq, (unsigned)_prefs.sf, (unsigned)_prefs.cr, (int)_prefs.tx_power_dbm);
+
+  return (n > 0 && (size_t)n < max_len) ? (size_t)n : 0;
+}
+
 struct FreqRange {
   uint32_t lower_freq, upper_freq;
 };
