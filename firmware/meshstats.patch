+ * quote here would not produce an odd-looking name but an unparseable message,
+ * and the receiving side would drop the whole reading. */
+static void jsonEscape(char *dest, size_t max, const char *src) {
+  size_t o = 0;
+  for (const char *p = src; *p && o + 2 < max; p++) {
+    unsigned char c = (unsigned char)*p;
+    if (c == '"' || c == '\\') { dest[o++] = '\\'; dest[o++] = (char)c; }
+    else if (c >= 0x20) { dest[o++] = (char)c; }
+  }
+  dest[o] = 0;
+}
+
+/* The neighbour list travels inside the stats payload as a "neighbors" array,
+ * because that is what the receiving side reads: it derives its own per-link
+ * neighbor_<prefix> history from these entries. An earlier version published
+ * them as separate metrics on their own topic, which nothing subscribed to --
+ * the data reached the broker and was thrown away there.
+ *
+ * Truncates instead of failing when the buffer runs out: a partial neighbour
+ * list is useful, a dropped stats message is not. */
+size_t MyMesh::appendNeighborsJson(char *out, size_t max_len) {
+  if (max_len < 32) return 0;
+  int n = snprintf(out, max_len, ",\"neighbors\":[");
+  if (n <= 0 || (size_t)n >= max_len) return 0;
+
+  int written = 0;
+#if MAX_NEIGHBOURS
+  uint32_t now = getRTCClock()->getCurrentTime();
+  for (int i = 0; i < MAX_NEIGHBOURS; i++) {
+    const NeighbourInfo *nb = &neighbours[i];
+    if (nb->heard_timestamp == 0) continue;
+
+    char hex[7];
+    mesh::Utils::toHex(hex, nb->id.pub_key, 3);      // 6 lowercase hex chars
+    char name[MAX_ADVERT_DATA_SIZE * 2];
+    jsonEscape(name, sizeof(name), nb->name);
+
+    uint32_t secs_ago = (now > nb->heard_timestamp) ? (now - nb->heard_timestamp) : 0;
+    int w = snprintf(out + n, max_len - n,
+                     "%s{\"prefix\":\"%s\",\"name\":\"%s\",\"snr\":%.2f,\"seen_min\":%u}",
+                     written ? "," : "", hex, name, nb->snr / 4.0f,
+                     (unsigned)(secs_ago / 60));
+    if (w <= 0 || (size_t)(n + w) >= max_len - 2) break;   // leave room to close
+    n += w;
+    written++;
+  }
+#endif
+
+  int w = snprintf(out + n, max_len - n, "]");
+  if (w <= 0 || (size_t)(n + w) >= max_len) return 0;
+  return (size_t)(n + w);
+}
+
+bool MyMesh::getClockHour(uint8_t *hour_out) {
+  uint32_t now = getRTCClock()->getCurrentTime();
+  if (now < 1700000000UL) return false;   // never set, or counting from zero
+  *hour_out = DateTime(now).hour();
+  return true;
+}
