+// ------------------------------- monitored repeaters -----------------------
+
+void MyMesh::clearMonitors() {
+  memset(monitors, 0, sizeof(monitors));
+  num_monitors = 0;
+}
+
+int MyMesh::addMonitor(const uint8_t *pub_key) {
+  if (num_monitors >= MAX_MONITORS) return -1;
+
+  MonitorInfo &m = monitors[num_monitors];
+  m.id = mesh::Identity(pub_key);
+  /* Once, here. ECDH costs tens of milliseconds, which is fine at config time
+   * and unacceptable in the receive path where the secret is needed. */
+  self_id.calcSharedSecret(m.shared_secret, m.id);
+  m.out_path_len = OUT_PATH_UNKNOWN;
+  return num_monitors++;
+}
+
+void MyMesh::resetMonitorPath(int idx) {
+  if (idx >= 0 && idx < num_monitors) monitors[idx].out_path_len = OUT_PATH_UNKNOWN;
+}
+
+int MyMesh::getMonitorPathLen(int idx) const {
+  if (idx < 0 || idx >= num_monitors) return -1;
+  return (monitors[idx].out_path_len == OUT_PATH_UNKNOWN) ? -1 : monitors[idx].out_path_len;
+}
+
+// Flood only while we have no path back; after that every poll goes direct.
+void MyMesh::sendToMonitor(MonitorInfo &m, mesh::Packet *pkt) {
+  if (m.out_path_len == OUT_PATH_UNKNOWN) {
+    sendFloodScoped(default_scope, pkt, 0, _prefs.path_hash_mode + 1);
+  } else {
+    sendDirect(pkt, m.out_path, m.out_path_len);
+  }
+}
+
+bool MyMesh::sendMonitorLogin(int idx, const char *password) {
+  if (idx < 0 || idx >= num_monitors) return false;
+  MonitorInfo &m = monitors[idx];
+
+  uint8_t temp[24];
+  uint32_t now = getRTCClock()->getCurrentTimeUnique();
+  memcpy(temp, &now, 4);      // also an extra blob, to keep the packet hash unique
+  int len = strlen(password);
+  if (len > 15) len = 15;     // protocol limit, same as the chat client uses
+  memcpy(&temp[4], password, len);
+
+  mesh::Packet *pkt = createAnonDatagram(PAYLOAD_TYPE_ANON_REQ, self_id, m.id,
+                                         m.shared_secret, temp, 4 + len);
+  if (!pkt) return false;
+  sendToMonitor(m, pkt);
+  return true;
+}
+
+bool MyMesh::sendMonitorStatusReq(int idx) {
+  if (idx < 0 || idx >= num_monitors) return false;
+  MonitorInfo &m = monitors[idx];
+
+  uint8_t temp[8];
+  uint32_t now = getRTCClock()->getCurrentTimeUnique();
+  memcpy(temp, &now, 4);
+  temp[4] = REQ_TYPE_GET_STATUS;
+  getRNG()->random(&temp[5], 3);   // padding that also keeps the packet hash unique
+
+  mesh::Packet *pkt = createDatagram(PAYLOAD_TYPE_REQ, m.id, m.shared_secret, temp, 8);
+  if (!pkt) return false;
+  sendToMonitor(m, pkt);
+  return true;
+}
+
+/* Telemetry is a separate request type because RepeaterStats has no room for
+ * sensors: temperature and voltages come back as CayenneLPP instead. The layout
+ * below mirrors how this same firmware answers the request (handleRequest
+ * above), which is the only specification that exists.
+ *
+ * payload[1] is an INVERSE permission mask -- the far side computes
+ * ~payload[1] -- so zero asks for everything it is willing to give, and it
+ * clamps that to base telemetry itself if we only hold guest rights. */
+bool MyMesh::sendMonitorTelemetryReq(int idx) {
+  if (idx < 0 || idx >= num_monitors) return false;
+  MonitorInfo &m = monitors[idx];
+
+  uint8_t temp[9];
+  uint32_t now = getRTCClock()->getCurrentTimeUnique();
+  memcpy(temp, &now, 4);
+  temp[4] = REQ_TYPE_GET_TELEMETRY_DATA;
+  memset(&temp[5], 0, 4);          // 4 reserved bytes; the first is that mask
+
+  mesh::Packet *pkt = createDatagram(PAYLOAD_TYPE_REQ, m.id, m.shared_secret, temp, sizeof(temp));
+  if (!pkt) return false;
+  sendToMonitor(m, pkt);
+  return true;
+}
+
+/* Sends one CLI command to a monitored repeater, as a text message, which is
+ * how the far side's own admin console is driven. Note the gate on the other
+ * end: onPeerDataRecv() only runs a command when client->isAdmin(), so this
+ * silently achieves nothing without admin rights on that node -- the caller
+ * must establish that first rather than fire and hope. */
+bool MyMesh::sendMonitorCliCmd(int idx, const char *cmd) {
+  if (idx < 0 || idx >= num_monitors || cmd == NULL) return false;
+  MonitorInfo &m = monitors[idx];
+
+  uint8_t temp[5 + MONITOR_CLI_MAX];
+  uint32_t now = getRTCClock()->getCurrentTimeUnique();
+  memcpy(temp, &now, 4);
+  temp[4] = (TXT_TYPE_CLI_DATA << 2);
+  size_t len = strlen(cmd);
+  if (len > MONITOR_CLI_MAX) len = MONITOR_CLI_MAX;
+  memcpy(&temp[5], cmd, len);
+
+  mesh::Packet *pkt = createDatagram(PAYLOAD_TYPE_TXT_MSG, m.id, m.shared_secret,
+                                     temp, 5 + len);
+  if (!pkt) return false;
+  sendToMonitor(m, pkt);
+  return true;
+}
+
+/* Neighbours of the monitored repeater. Parameters again taken from how this
+ * firmware answers the request: version, how many, from which offset, sort
+ * order (0 = newest heard first) and how many bytes of each neighbour's public
+ * key to return. Three bytes is the same six hex characters the rest of this
+ * pipeline uses to name a node, and keeps one entry at 8 bytes so a useful
+ * number of them fit in a single packet. */
+bool MyMesh::sendMonitorNeighboursReq(int idx) {
+  if (idx < 0 || idx >= num_monitors) return false;
+  MonitorInfo &m = monitors[idx];
+
+  uint8_t temp[15];
+  uint32_t now = getRTCClock()->getCurrentTimeUnique();
+  memcpy(temp, &now, 4);
+  temp[4] = REQ_TYPE_GET_NEIGHBOURS;
+  temp[5] = 0;                     // request version
+  temp[6] = MONITOR_NBR_MAX;       // how many to fetch
+  temp[7] = 0; temp[8] = 0;        // offset into their list
+  temp[9] = 0;                     // order: newest heard first
+  temp[10] = MONITOR_NBR_PREFIX;   // bytes of pub_key per entry
+  getRNG()->random(&temp[11], 4);  // blob, keeps the packet hash unique
+
+  mesh::Packet *pkt = createDatagram(PAYLOAD_TYPE_REQ, m.id, m.shared_secret, temp, sizeof(temp));
+  if (!pkt) return false;
+  sendToMonitor(m, pkt);
+  return true;
 }
 
