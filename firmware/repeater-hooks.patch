+bool MyMesh::findNeighbourByPrefix(const uint8_t *prefix, int prefix_len, uint8_t *full_key_out,
+                                   char *name_out, size_t name_max) const {
+#if MAX_NEIGHBOURS
+  if (prefix_len <= 0 || prefix_len > PUB_KEY_SIZE) return false;
+  for (int i = 0; i < MAX_NEIGHBOURS; i++) {
+    const NeighbourInfo *nb = &neighbours[i];
+    if (nb->heard_timestamp == 0) continue;
+    if (memcmp(nb->id.pub_key, prefix, prefix_len) != 0) continue;
+
+    memcpy(full_key_out, nb->id.pub_key, PUB_KEY_SIZE);
+    StrHelper::strncpy(name_out, nb->name, name_max);
+    return true;
+  }
 #endif
+  return false;
+}
