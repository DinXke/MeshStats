+size_t MyMesh::fillStatsJson(char *out, size_t max_len) {
+  if (out == NULL || max_len < 256) return 0;
+
+  char pub_hex[13];
+  mesh::Utils::toHex(pub_hex, self_id.pub_key, 6);   // 6 bytes -> 12 hex chars
+
+  /* The receiving site wants to know which custom build produced this payload,
+   * independently of the MeshCore version underneath it. */
+#ifdef MESHSTATS_NET
+  const char *ms_ver = MESHSTATS_VERSION;
+#else
+  const char *ms_ver = "";
+#endif
+
+  uint32_t uptime_secs = (uint32_t)(uptime_millis / 1000);
+  uint32_t tx_air = getTotalAirTime() / 1000;
+  uint32_t rx_air = getReceiveAirTime() / 1000;
+
+  int n = snprintf(out, max_len,
+    "{\"repeater\":{\"pubkey_prefix\":\"%s\",\"name\":\"%s\","
+    "\"fw\":\"" FIRMWARE_VERSION "\",\"fw_meshstats\":\"%s\"},"
+    "\"metrics\":{"
+      "\"online\":true,"
+      "\"bat\":%.3f,"
+      "\"uptime\":%.5f,"
+      "\"noise_floor\":%d,"
+      "\"last_rssi\":%d,"
+      "\"last_snr\":%.2f,"
+      "\"airtime\":%.1f,"
+      "\"rx_airtime\":%.1f,"
+      "\"nb_recv\":%u,"
+      "\"nb_sent\":%u,"
+      "\"sent_flood\":%u,"
+      "\"sent_direct\":%u,"
+      "\"recv_flood\":%u,"
+      "\"recv_direct\":%u,"
+      "\"recv_errors\":%u,"
+      "\"direct_dups\":%u,"
+      "\"flood_dups\":%u,"
+      "\"tx_queue_len\":%u,"
+      "\"err_events\":%u,"
+      "\"freq\":%.4f,"
+      "\"sf\":%u,"
+      "\"cr\":%u,"
+      "\"tx\":%d"
+    "}}",
+    pub_hex, _prefs.node_name, ms_ver,
+    board.getBattMilliVolts() / 1000.0f,
+    uptime_secs / 86400.0,
+    (int)_radio->getNoiseFloor(),
+    (int)radio_driver.getLastRSSI(),
+    radio_driver.getLastSNR(),
+    tx_air / 60.0f,
+    rx_air / 60.0f,
+    (unsigned)radio_driver.getPacketsRecv(),
+    (unsigned)radio_driver.getPacketsSent(),
+    (unsigned)getNumSentFlood(),
+    (unsigned)getNumSentDirect(),
+    (unsigned)getNumRecvFlood(),
+    (unsigned)getNumRecvDirect(),
+    (unsigned)radio_driver.getPacketsRecvErrors(),
+    (unsigned)((SimpleMeshTables *)getTables())->getNumDirectDups(),
+    (unsigned)((SimpleMeshTables *)getTables())->getNumFloodDups(),
+    (unsigned)_mgr->getOutboundTotal(),
+    (unsigned)_err_flags,
+    _prefs.freq, (unsigned)_prefs.sf, (unsigned)_prefs.cr, (int)_prefs.tx_power_dbm);
+
+  return (n > 0 && (size_t)n < max_len) ? (size_t)n : 0;
+}
+
+bool MyMesh::getClockHour(uint8_t *hour_out) {
+  uint32_t now = getRTCClock()->getCurrentTime();
+  if (now < 1700000000UL) return false;   // never set, or counting from zero
+  *hour_out = DateTime(now).hour();
+  return true;
+}
