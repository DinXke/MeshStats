+/* Replies from a monitored repeater. Nothing is parsed here beyond handing the
+ * bytes on: this runs in the receive path, so it may only copy. MeshManagerNet
+ * knows what it asked for and interprets accordingly. */
+void MyMesh::handleMonitorData(int mon_idx, uint8_t type, const uint8_t *data, size_t len) {
+  if (mon_idx >= num_monitors) return;
+  /* RESPONSE carries the status/telemetry/neighbour replies; TXT_MSG carries
+   * the answer to a CLI command we sent. Both are forwarded, with the type, so
+   * the other side knows which of the two it is looking at. */
+  if (type != PAYLOAD_TYPE_RESPONSE && type != PAYLOAD_TYPE_TXT_MSG) return;
+#ifdef MESHMANAGER_NET
+  meshmanager_on_monitor_response(mon_idx, type, data, (int)len);
+#endif
+}
