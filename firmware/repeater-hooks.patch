+bool MyMesh::getNeighbourAt(int idx, char *pub_hex, char *name_out, size_t name_max,
+                            uint32_t *secs_ago, int8_t *snr_out) const {
+#if MAX_NEIGHBOURS
+  int n = 0;
+  for (int i = 0; i < MAX_NEIGHBOURS; i++) {
+    const NeighbourInfo *nb = &neighbours[i];
+    if (nb->heard_timestamp == 0) continue;
+    if (n++ != idx) continue;
+
+    mesh::Utils::toHex(pub_hex, nb->id.pub_key, PUB_KEY_SIZE);
+    StrHelper::strncpy(name_out, nb->name, name_max);
+    uint32_t now = getRTCClock()->getCurrentTime();
+    *secs_ago = (now > nb->heard_timestamp) ? (now - nb->heard_timestamp) : 0;
+    *snr_out = nb->snr;
+    return true;
+  }
+#endif
+  return false;
+}
