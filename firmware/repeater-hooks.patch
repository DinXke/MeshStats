+size_t MyMesh::fillStatsJson(char *out, size_t max_len) {
+  if (out == NULL || max_len < 256) return 0;
+
+  char pub_hex[13];
+  mesh::Utils::toHex(pub_hex, self_id.pub_key, 6);   // 6 bytes -> 12 hex chars
+
+  /* The receiving site wants to know which custom build produced this payload,
+   * independently of the MeshCore version underneath it. */
+#ifdef MESHSTATS_NET
+  const char *ms_ver = MESHSTATS_VERSION;
+#else
+  const char *ms_ver = "";
+#endif
+
+  uint32_t uptime_secs = (uint32_t)(uptime_millis / 1000);
+  uint32_t tx_air = getTotalAirTime() / 1000;
+  uint32_t rx_air = getReceiveAirTime() / 1000;
+
+  uint16_t batt_mv = board.getBattMilliVolts();
+#ifdef MESHSTATS_NET
+  int batt_pct = meshstats_batt_percent(batt_mv);
+#else
+  int batt_pct = -1;
+#endif
+
+  /* MCU temperature. Only emitted when the chip actually returns one -- an
+   * ESP32-C3 hands back NAN, and a fabricated temperature is worse on a graph
+   * than a gap. */
+  char temp_field[40];
+  temp_field[0] = 0;
+  float mcu_temp = board.getMCUTemperature();
+  if (!isnan(mcu_temp)) {
+    snprintf(temp_field, sizeof(temp_field), ",\"ch1_temperature\":%.2f", mcu_temp);
+  }
+
+  int n = snprintf(out, max_len,
+    "{\"repeater\":{\"pubkey_prefix\":\"%s\",\"name\":\"%s\","
+    "\"fw\":\"" FIRMWARE_VERSION "\",\"fw_meshstats\":\"%s\"},"
+    "\"metrics\":{"
+      "\"online\":true,"
+      "\"bat\":%.3f,"
+      "\"uptime\":%.5f,"
+      "\"noise_floor\":%d,"
+      "\"last_rssi\":%d,"
+      "\"last_snr\":%.2f,"
+      "\"airtime\":%.1f,"
+      "\"rx_airtime\":%.1f,"
+      "\"nb_recv\":%u,"
+      "\"nb_sent\":%u,"
+      "\"sent_flood\":%u,"
+      "\"sent_direct\":%u,"
+      "\"recv_flood\":%u,"
+      "\"recv_direct\":%u,"
+      "\"recv_errors\":%u,"
+      "\"direct_dups\":%u,"
+      "\"flood_dups\":%u,"
+      "\"tx_queue_len\":%u,"
+      "\"err_events\":%u,"
+      "\"ch1_voltage\":%.3f,"
+      "\"battery_percentage\":%d,"
+      "\"neighbor_count\":%d,"
+      "\"freq\":%.4f,"
+      "\"sf\":%u,"
+      "\"cr\":%u,"
+      "\"tx\":%d"
+      "%s"
+    "}}",
+    pub_hex, _prefs.node_name, ms_ver,
+    board.getBattMilliVolts() / 1000.0f,
+    uptime_secs / 86400.0,
+    (int)_radio->getNoiseFloor(),
+    (int)radio_driver.getLastRSSI(),
+    radio_driver.getLastSNR(),
+    tx_air / 60.0f,
+    rx_air / 60.0f,
+    (unsigned)radio_driver.getPacketsRecv(),
+    (unsigned)radio_driver.getPacketsSent(),
+    (unsigned)getNumSentFlood(),
+    (unsigned)getNumSentDirect(),
+    (unsigned)getNumRecvFlood(),
+    (unsigned)getNumRecvDirect(),
+    (unsigned)radio_driver.getPacketsRecvErrors(),
+    (unsigned)((SimpleMeshTables *)getTables())->getNumDirectDups(),
+    (unsigned)((SimpleMeshTables *)getTables())->getNumFloodDups(),
+    (unsigned)_mgr->getOutboundTotal(),
+    (unsigned)_err_flags,
+    batt_mv / 1000.0f, batt_pct, getNumNeighbours(),
+    _prefs.freq, (unsigned)_prefs.sf, (unsigned)_prefs.cr, (int)_prefs.tx_power_dbm,
+    temp_field);
+
+  return (n > 0 && (size_t)n < max_len) ? (size_t)n : 0;
+}
+
+/* Per-neighbour SNR, on its own because it does not fit anywhere else: with a
+ * few dozen neighbours this outgrows both the stats payload and a sensible
+ * MQTT buffer. Same envelope as fillStatsJson so the receiving side can run it
+ * through the identical parser and merge on pubkey_prefix.
+ *
+ * Truncates rather than fails when the buffer runs out: a partial neighbour
+ * list is useful, a dropped message is not. */
+size_t MyMesh::fillNeighborsJson(char *out, size_t max_len) {
+  if (out == NULL || max_len < 128) return 0;
+
+  char pub_hex[13];
+  mesh::Utils::toHex(pub_hex, self_id.pub_key, 6);
+
+  int n = snprintf(out, max_len,
+                   "{\"repeater\":{\"pubkey_prefix\":\"%s\",\"name\":\"%s\"},"
+                   "\"metrics\":{\"neighbor_count\":%d",
+                   pub_hex, _prefs.node_name, getNumNeighbours());
+  if (n <= 0 || (size_t)n >= max_len) return 0;
+
+#if MAX_NEIGHBOURS
+  for (int i = 0; i < MAX_NEIGHBOURS; i++) {
+    const NeighbourInfo *nb = &neighbours[i];
+    if (nb->heard_timestamp == 0) continue;
+
+    char hex[7];
+    mesh::Utils::toHex(hex, nb->id.pub_key, 3);   // 6 lowercase hex chars
+    int w = snprintf(out + n, max_len - n, ",\"neighbor_%s\":%.2f", hex, nb->snr / 4.0f);
+    if (w <= 0 || (size_t)(n + w) >= max_len - 4) break;   // leave room to close
+    n += w;
+  }
+#endif
+
+  int w = snprintf(out + n, max_len - n, "}}");
+  if (w <= 0 || (size_t)(n + w) >= max_len) return 0;
+  return (size_t)(n + w);
+}
